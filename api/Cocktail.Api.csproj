<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the newest runtime SWA managed functions and .NET both currently
         support (dotnet-isolated:9.0 is newer on SWA's side, .NET 9 already left
         support). See docs/IMPLEMENTATION_PLAN.md §0.2 and CLAUDE.md "Hard platform
         constraints" #6 for the migration path once this stops being true. -->
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cocktail.Api</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <!-- Pinned to 2.23.0, not the latest 3.x — Microsoft.Azure.Functions.Worker.ApplicationInsights
         2.51.0 depends on Microsoft.ApplicationInsights.PerfCounterCollector 2.23.0, which
         itself depends on the 2.x Microsoft.ApplicationInsights core assembly. Taking the
         3.x WorkerService package here creates a version conflict that only fails at
         runtime (TypeLoadException on ITelemetryInitializer) — dotnet build does not catch
         it, only actually running the Functions host does. -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.12.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="host.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Gitignored; each developer creates their own from local.settings.json.example. -->
    <None Include="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('local.settings.json')" />
    <!-- Embedded (not just copied) so onboarding/example seeding never depends on a
         relative file path on the deployed host. Read by Services/PantrySeedCatalog.cs. -->
    <EmbeddedResource Include="../data/pantry-seed.json" LogicalName="data.pantry-seed.json" />
  </ItemGroup>

</Project>
